# ── Frontend (Next.js / Vercel) ───────────────────────────────────────────────
# En Vercel Production debe ser la URL pública (no localhost).
# En Supabase → Authentication → URL Configuration:
#   Site URL = mismo valor (ej. https://postventa-inteligente.vercel.app)
#   Redirect URLs = esa URL + /auth/** y http://localhost:3000/** para desarrollo
NEXT_PUBLIC_APP_URL=https://postventa-inteligente.vercel.app

# API Node.js (opcional)
NEXT_PUBLIC_API_URL=

# Supabase (PostgreSQL + Auth + Edge Functions)
# Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://obhgdgnozeaneljprudd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-public-key

# Solo servidor (Vercel → Environment Variables). Nunca exponer en el cliente.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# Obligatorio para el cron diario de alertas MTTO (Vercel Cron → Edge Function)
# Genera uno largo, ej. en PowerShell: [guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')
CRON_SECRET=un-token-secreto-largo

# Gmail para alertas MTTO: solo en Supabase Edge Function Secrets (NO en Vercel):
# GMAIL_USER=storageentrenapartequipos@gmail.com
# GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
